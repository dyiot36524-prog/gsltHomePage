{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,

  "redirects": [
    { "source": "/about.html", "destination": "https://www.gslt.kr/about", "statusCode": 301 },
    { "source": "/siot.html", "destination": "https://www.gslt.kr/siot", "statusCode": 301 },
    { "source": "/bizmoa.html", "destination": "https://www.gslt.kr/bizmoa", "statusCode": 301 },
    { "source": "/morak.html", "destination": "https://www.gslt.kr/morak", "statusCode": 301 },
    { "source": "/news.html", "destination": "https://www.gslt.kr/news", "statusCode": 301 },
    { "source": "/downloads.html", "destination": "https://www.gslt.kr/downloads", "statusCode": 301 },
    { "source": "/portfolio.html", "destination": "https://www.gslt.kr/portfolio", "statusCode": 301 },
    { "source": "/dailo.html", "destination": "https://www.gslt.kr/", "statusCode": 301 },
    { "source": "/404.html", "destination": "https://www.gslt.kr/", "statusCode": 301 },
    { "source": "/index.html", "destination": "https://www.gslt.kr/", "statusCode": 301 },
    { "source": "/admin.html", "destination": "https://www.gslt.kr/admin.html", "statusCode": 301 },
    { "source": "/p/:id.html", "destination": "https://www.gslt.kr/news/:id", "statusCode": 301 },
    { "source": "/post.html", "has": [{ "type": "query", "key": "id", "value": "(?<id>[A-Za-z0-9_-]+)" }], "destination": "https://www.gslt.kr/news/:id", "statusCode": 301 },
    { "source": "/post.html", "destination": "https://www.gslt.kr/news", "statusCode": 301 },
    { "source": "/(.*)", "destination": "https://www.gslt.kr/$1", "statusCode": 301 }
  ],

  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/img/hero-v(\\d+)-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
