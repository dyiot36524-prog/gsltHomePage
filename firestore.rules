// GSLT 홈페이지 Firestore 보안 규칙
// 적용 위치: Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 게시
//
// 소유자: dyiot36524@gmail.com — 규칙에 박아 둔다. 목록이 비거나 잘못 지워져도
//   이 계정만은 항상 들어올 수 있어야 스스로를 잠그는 사고가 나지 않는다.
// 그 밖의 관리자: admins 컬렉션에 이메일을 문서 ID로 넣으면 된다.
//   관리자 페이지의 '관리자' 탭이 이 컬렉션을 관리한다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 소유자. 절대 잠기지 않는 최후의 열쇠라 목록을 거치지 않는다.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'dyiot36524@gmail.com';
    }

    function isAdmin() {
      return isOwner() || (
        request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // 관리자 명단. 문서 ID가 곧 이메일이다.
    // 명단을 고치는 건 소유자만 — 관리자가 서로를 지우거나 자기를 승격시키지 못하게 한다.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // 게시글: 방문자는 게시된 글만 읽기, 쓰기는 관리자만
    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, delete: if isAdmin();
      // 방문자는 게시된 글의 조회수(views)만 정확히 +1 가능
      allow update: if isAdmin() || (
        resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.get('views', 0) + 1
      );
    }

    // 챗봇 지식베이스. 관리자 페이지의 '지식베이스' 탭이 관리한다.
    //
    // 공개된 문서는 누구나 읽을 수 있다 — 어차피 챗봇 답변으로 나가는 내용이고,
    // 서버가 인증 없이 읽는 posts·settings와 같은 방식이다.
    // **그러므로 여기에 대외비를 넣으면 그대로 노출된다.** 관리자 화면에 그 경고를 띄운다.
    match /knowledge/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 사이트 설정(메뉴 노출): 누구나 읽기, 쓰기는 관리자만
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 상담 문의: 방문자는 접수(생성)만 가능, 열람·관리는 관리자만
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'company', 'email', 'phone', 'message', 'read', 'createdAt'])
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
